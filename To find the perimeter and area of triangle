#include<stdio.h>
#include<math.h>
void main()
 {
    float a, b, c, s, area;
    printf("Enter three sides: ");
    scanf("%f %f %f", &a, &b, &c);
    if (a + b > c && a + c > b && b + c > a)
    {
        s = (a + b + c) / 2;
        area = sqrt(s * (s - a) * (s - b) * (s - c));
        printf("Area of triangle = %.2f", area);
    }
    else
    {
        printf("Invalid triangle");
    }
}

