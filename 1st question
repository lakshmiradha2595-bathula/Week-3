#include <stdio.h>
#include <math.h>

int main()
{
    float num, result;

    printf("Enter a number: ");
    scanf("%f", &num);

    if (num >= 0)
    {
        result = sqrt(num);
        printf("Square root = %.2f", result);
    }
    else
    {
        printf("Invalid input");
    }

    return 0;
}

